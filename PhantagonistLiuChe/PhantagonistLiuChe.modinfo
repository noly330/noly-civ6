  <Properties>
    <Name>LOC_PHANTA_LIU_CHE_MOD_NAME</Name>
    <Description>LOC_PHANTA_LIU_CHE_MOD_DESCRIPTION</Description>
    <Created>1755968267</Created>
    <Teaser>LOC_PHANTA_LIU_CHE_MOD_TEASER</Teaser>
    <Authors>Phantagonist</Authors>
    <CompatibleVersions>1.2,2.0</CompatibleVersions>
  </Properties>
<LocalizedText>
    <Text id="LOC_PHANTA_LIU_CHE_MOD_NAME">
      <en_US>Phantagonist’s Liu Che (Emperor Wu of Han)</en_US>
      <zh_Hans_CN>Phantagonist：汉武帝刘彻</zh_Hans_CN>
      <zh_Hant_HK>Phantagonist：漢武帝劉徹</zh_Hant_HK>
    </Text>
    <Text id="LOC_PHANTA_LIU_CHE_MOD_TEASER">
      <en_US>Adds Liu Che, Emperor Wu of Han, as an alternate leader for China.</en_US>
      <zh_Hans_CN>新增汉武帝刘彻作为中国领袖。</zh_Hans_CN>
      <zh_Hant_HK>新增漢武帝劉徹作為中國領袖。</zh_Hant_HK>
    </Text>
    <Text id="LOC_PHANTA_LIU_CHE_MOD_DESCRIPTION">
      <en_US>Adds Liu Che, Emperor Wu of Han, as an alternate leader for China.</en_US>
      <zh_Hans_CN>新增汉武帝刘彻作为中国领袖。</zh_Hans_CN>
      <zh_Hant_HK>新增漢武帝劉徹作為中國領袖。</zh_Hant_HK>
    </Text>
</LocalizedText>
